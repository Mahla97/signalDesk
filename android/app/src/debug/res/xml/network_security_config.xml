<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Allows a plain-HTTP dev backend (emulator 10.0.2.2 or a
  LAN IP) and user-installed CAs (for proxy testing). Release builds use
  src/main/res/xml/network_security_config.xml, which forbids both.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
