<?xml version="1.0" encoding="utf-8"?>
<!--
  Release policy: HTTPS only, system CAs only (user-installed CAs are not trusted,
  so a proxy cert on the phone can't read traffic). Debug builds override this
  file from src/debug/res/xml/ to allow a plain-HTTP dev backend.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
