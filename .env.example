# SignalDesk backend environment.
#
# For local development, copy this file to `.env` (gitignored) and fill in real
# values. In production, set these as environment variables in your hosting
# platform instead — never commit real secrets.

# --- Password-reset email (SMTP) ---
# Example below uses Resend. When SMTP_HOST is empty, the reset link is logged
# to the server console instead of emailed.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxx          # your Resend API key
SMTP_FROM=no-reply@yourdomain.com

# Public origin used to build the password-reset link.
APP_URL=http://localhost:5173

# --- Auth / webhook ---
# TRADINGVIEW_WEBHOOK_SECRET=change-me-tradingview-secret
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Kx7-Panel-Trade-92

# --- Optional: Firebase push ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FCM_SERVICE_ACCOUNT_JSON={...}
