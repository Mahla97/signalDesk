# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Server runtime data (SQLite DB — contains user data, never commit)
server/data/
*.db
*.db-shm
*.db-wal

# Environment files
.env
.env.*
!.env.example

# Firebase service-account keys (server-only secret). google-services.json is
# NOT secret — it ships inside the app on purpose, so it is not ignored.
service-account*.json
*service-account*.json
*firebase-adminsdk*.json

# Local notes with credentials
docs/data.txt


# Logs
*.log
npm-debug.log*

# Editor / IDE
.idea/
.vscode/
*.swp

# Claude / tooling config
.claude/
.rtk/

# OS
.DS_Store
Thumbs.db
